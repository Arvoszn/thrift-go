# Thrift Go runtime configuration.
# Copy to .env and fill in your own values. Never commit a filled .env.

PORT=4331
GRAPH_VERSION=v21.0

# Meta app credentials (Instagram Direct Login + webhook signatures)
THRIFT_INSTAGRAM_APP_ID=your_instagram_app_id
THRIFT_INSTAGRAM_APP_SECRET=your_instagram_app_secret
SPAWN_THRIFT_APP_ID=your_meta_app_id
SPAWN_THRIFT_APP_SECRET=your_meta_app_secret

# Webhook verification token (must match the Meta app dashboard)
VERIFY_TOKEN=your_webhook_verify_token

# Public URL exposed by your tunnel (webhook + OAuth redirect callbacks)
THRIFT_PUBLIC_URL=https://your-hostname.example.com

# Outbound customer messages are disabled unless this is 1
THRIFT_SEND_ENABLED=0

# Client / personal accounts that must never be connected:
# comma-separated scoped IDs and name fragments (case-insensitive)
THRIFT_PROTECTED_IDS=
THRIFT_PROTECTED_NAMES=

# Optional overrides
# THRIFT_DATA_DIR=./data
# THRIFT_STORE_DIR=~/.config/thrift-go
# THRIFT_PAUSE_FILE=./PAUSED
